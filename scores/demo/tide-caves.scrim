title    Tide Caves
composer musicbox demo
about    Exploring sea caves at low tide. Higher intensity adds marimba and shaker, then drums and vibes. Combat brings war drums, pizzicato and brass.
tempo    96
beats    4
steps    4        # 16 steps per bar
swing    0.08
reverb   0.4
key      D dorian

# layer 0 always plays; intensity 1 adds layer 1, intensity 2 adds layer 2
voice lead    flute     vol=0.9  pan=-0.15
voice pad     strings   vol=0.4  pan=0.2   center=E4 att=0.3
voice bass    fretless  vol=0.85
voice marimba marimba   vol=0.75 pan=0.35  layer=1
voice shaker  shaker    vol=0.35 pan=-0.4  layer=1
voice vibes   vibes     vol=0.55 pan=-0.3  layer=2
voice kick    kick      vol=0.6            layer=2
voice rim     rim       vol=0.35 pan=0.15  layer=2
# combat
voice trumpet trumpet   vol=0.85 pan=-0.1
voice brass   brass     vol=0.6  pan=0.15  center=G4 layer=1
voice pizz    pizz      vol=0.8  pan=0.25
voice war     tomlo     vol=0.75
voice snare   snare     vol=0.5  pan=0.1
voice timp    timpani   vol=0.75           layer=1
voice crash   crash     vol=0.3  pan=-0.2  layer=1

# ------------------------------------------------------------- explore
pattern intro
harmony | Dm7 | G |
pad     | [*]?:16 | % |
bass    | D2:16 | G1:16 |
marimba | D4- A4- F4- A4- C5- A4- F4- A4- | D4- G4- B4- G4- D5- B4- G4- B4- |

